{
  "name": "visionflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js",
    "#database/*": "./database/*.js"
  },
  "scripts": {
    "dev": "node --import tsx bin/server.ts",
    "build": "node ace build",
    "start": "node bin/server.js",
    "migration:run": "node --import tsx ace migration:run",
    "migration:fresh": "node --import tsx ace migration:fresh"
  },
  "dependencies": {
    "@adonisjs/core": "^6.14.1",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.2.0",
    "@adonisjs/redis": "^9.2.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
