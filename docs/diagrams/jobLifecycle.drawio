<mxfile host="app.diagrams.net" agent="VisionFlow" version="22.1.0">
  <diagram id="job-lifecycle" name="Job Lifecycle">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="VisionFlow — Job Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="20" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="pending" value="pending&#xa;progress = 0%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="370" y="130" width="160" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="processing" value="processing&#xa;progress 5% → 95%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="370" y="230" width="160" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="completed" value="completed&#xa;progress = 100%&#xa;video + report ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="150" y="380" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="failed" value="failed&#xa;errorMessage stored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="550" y="380" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="endOk" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#333333;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="235" y="520" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="endFail" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#333333;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="635" y="520" width="30" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="steps" value="Processing steps&#xa;&#xa;• FFmpeg normalize (5–15%)&#xa;• YOLO + OpenCV frames (15–95%)&#xa;• Audio restore + JSON report (95–100%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="upload" style="endArrow=block;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="start" target="pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="processor picks job" style="endArrow=block;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="pending" target="processing">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="success" style="endArrow=block;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="processing" target="completed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="error" style="endArrow=block;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="processing" target="failed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="validation error" style="endArrow=block;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="pending" target="failed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="158"/>
              <mxPoint x="650" y="380"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t6" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="completed" target="endOk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t7" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="failed" target="endFail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="during" style="endArrow=open;dashed=1;html=1;strokeWidth=1;strokeColor=#999999;fontSize=11" edge="1" parent="1" source="processing" target="steps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
