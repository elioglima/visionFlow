<mxfile host="app.diagrams.net" agent="VisionFlow" version="22.1.0">
  <diagram id="video-processing-flow" name="Video Processing Flow">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="VisionFlow — Video Processing Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="1. User uploads video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="70" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2. Next.js sends POST /api/videos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3. API validates format and size (max 100MB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="210" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4. Job created in PostgreSQL (status: pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="280" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5. Job id enqueued in Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="350" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="6. Web polls GET /api/videos/:id every 2s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1" vertex="1" parent="1">
          <mxGeometry x="200" y="420" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="7. Python processor dequeues job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="490" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="8. FFmpeg normalizes video (resolution, FPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="560" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value="9. YOLO detects and tracks people per frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="630" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s10" value="10. OpenCV draws boxes, IDs and counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="700" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s11" value="11. Processor updates progress via PATCH API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1" vertex="1" parent="1">
          <mxGeometry x="200" y="770" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s12" value="12. FFmpeg restores audio and writes MP4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="840" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s13" value="13. JSON report generated with metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="910" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s14" value="14. Job completed — user views stats and downloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="980" width="300" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;html=1" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
